# Image runtime configurável, mantendo versão/digest verificável.
NODE_IMAGE=node:22.23.4-bookworm-slim
# Obrigatórios; make bootstrap cria segredos aleatórios se .env ainda não existir.
POSTGRES_IMAGE=postgres:17.11-bookworm
POSTGRES_USER=curriculos
POSTGRES_DB=curriculos
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# URL pública completa; use HTTPS em servidor remoto. Precisa corresponder ao navegador/Origin.
PUBLIC_URL=http://localhost:3000
PORT=3000
APP_NAME=Currículos Abertos
# Só para ferramentas executadas no host; app/worker usam endereço interno db no Compose.
DATABASE_URL=postgresql://curriculos:SENHA_LOCAL@localhost:55437/curriculos
# Opcional: volume explícito para migração/rollback; vazio usa o volume do projeto Compose.
DATABASE_VOLUME=
DATABASE_VOLUME_EXTERNAL=false
DATABASE_PORT=55437
# Armazenamento persistente; o Compose usa /app/var.
STORAGE_DIR=var
EXPORT_STORAGE_DIR=var
# Opcional no host; prefere venv-pipeline local. Docker usa /opt/venv/bin/python.
PIPELINE_PYTHON=
PYTHON_BIN=
# Monitoramento não promove automaticamente novos dados.
SOURCE_CHECK_ENABLED=false
SOURCE_CHECK_INTERVAL_SECONDS=86400
# Referenciais oficiais podem superar 128 MiB; limite explícito 200 MiB por artefato.
WORKER_MEMORY_LIMIT=4g
WORKER_CPUS=2.0
SOURCE_MAX_BYTES=209715200
SOURCE_MAX_PAGES=2500
SOURCE_TIMEOUT_SECONDS=90
JOB_TIMEOUT_SECONDS=7200
PUBLIC_RATE_LIMIT=120
EXPORT_RATE_LIMIT=10
MCP_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000
# BUNDLE opcional: caminho dentro do projeto, caso não queira o bundle mais recente entregue.
# Importação JSON grande usa streaming; não aumenta o limite de string/heap.
DATA_MAX_STREAM_BYTES=10737418240
DATA_MAX_FILE_BYTES=268435456
DATA_MAX_DECODED_BYTES=536870912
DATA_BUNDLE=
