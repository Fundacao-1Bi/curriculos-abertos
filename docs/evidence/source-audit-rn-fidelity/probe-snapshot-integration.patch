+   if not text:raise ValueError('Explicit inline definition has no wording')
+   # The prior candidate may have swallowed the second printed definition.
+   for item in items:
+    if item.get('code')==match.group()or not item.get('code'):continue
+    b=item['evidence'][0].get('bbox')
+    if b and all(abs(b[j]-region['bbox'][j])<1 for j in range(4))and match.group()in item['text']:
+     first=item['text'].split(match.group(),1)[0].rstrip(' (');rebuilt=make_item(source,item['code'],first,page_number,item['evidence'][0]['method'],item['evidence'][0]['locator']);item['text']=first;item['normalized_text']=rebuilt['normalized_text'];item['evidence'][0]['excerpt']=first
+   already=[i for i in items if i.get('code')==match.group()and i['evidence'][0]['page']==page_number and i['evidence'][0].get('bbox')and all(abs(i['evidence'][0]['bbox'][j]-region['bbox'][j])<1 for j in range(4))]
+   if already:continue
+   item=make_item(source,match.group(),text,page_number,'rn-inline-explicit-definition-v1',region['locator']+f'/inline-definition:{ci}',context=region['header'],quality='literal_definition_boundary_checked');item['evidence'][0].update(bbox=region['bbox'],excerpt=text);item['source_context']={'documentary_role':'learning_definition','original_cell_text':region['text'],'cell_bbox':region['bbox'],'header':region['header'],'inline_definition_boundary':'sentence_terminator_then_code_then_dash','source_code_start':match.start()};item['document_specific_adapter']='rn-document-roles-v1';items.append(item);recovered.append({'code':match.group(),'page':page_number,'locator':item['evidence'][0]['locator'],'original_boundary':region['text'][max(0,match.start()-25):match.end()+25]})
+ return items,recovered
