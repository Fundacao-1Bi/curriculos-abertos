+  item=make_item(source,a['code'],a['code'],page_number,'rn-explicit-document-reference-v1',locator,context=r['header'],quality='literal_reference_role_checked')
+  item.update(kind='referencia_no_documento',positions=[],position_unknown_reason='Referência literal em cartão/célula de contexto; nenhum posicionamento ou texto nacional herdado automaticamente.',document_specific_adapter='rn-document-roles-v1')
+  item['evidence'][0].update(bbox=a['bbox'],excerpt=a['code'],evidence_role='literal_code_reference')
+  item['source_context']={'documentary_role':r['role'],'original_cell_text':r['text'],'cell_bbox':r['bbox'],'header':r['header'],'header_bbox':r.get('header_bbox'),'reference_semantics':'Literal citation only. Neighboring/context prose is retained here; it is not the wording of this code. No equivalence or learning definition inferred.'}
+  item['extraction_original_text']=r['text'];references.append(item)
+ output,inline_recovery=split_inline_primary_definitions(source,page_number,regions,kept+definitions+references,code_re,make_item,clean_text)
+ return output,{'applicable':True,'inline_definition_recovery':inline_recovery,'definition_records':len(definitions),'removed_candidates':removed,'reference_records':len(references),'preserved_candidates':len(kept),'primary_source_anchors':sum(r is not None and r['role']=='learning_definition'for a,r in classified),'unknown_source_anchors':sum(r is None for a,r in classified)}
