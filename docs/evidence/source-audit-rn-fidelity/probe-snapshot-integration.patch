+ t=re.sub(r'\b(habilidade|exemplos)(?: \1)+\b',r'\1',t)
+ if t in ('habilidade','habilidades'):return'learning_definition'
+ if t.startswith('explicacao')and'habilidade'in t:return'explanation_reference_context'
+ if t.startswith('exemplos'):return'example_reference_context'
+ if t.startswith('sugestoes didaticas'):return'pedagogical_reference_context'
+ if t.startswith('objeto')and'conhecimento'in t:return'knowledge_object_context'
+ return None
+def contains(box,x,y):return box[0]<=x<box[2]and box[1]<=y<box[3]
+def code_occurrences(reader,code_re):
+ """Locate actual stream occurrences, including duplicates; never search first hit."""
+ text=[];mapping=[]
+ for line in reader.lines:
+  for cluster in line:
+   text.extend(cluster['text']);mapping.extend([cluster['box']]*len(cluster['text']))
+  text.append('\n');mapping.append(None)
+ text=''.join(text);output=[]
+ for ordinal,m in enumerate(code_re.finditer(text)):
+  boxes=[b for b in mapping[m.start():m.end()]if b is not None]
+  if not boxes:continue
+  box=[min(b[0]for b in boxes),min(b[1]for b in boxes),max(b[2]for b in boxes),max(b[3]for b in boxes)]
+  output.append({'code':m.group(),'ordinal_in_page':ordinal,'bbox':box,'native_context':text[max(0,m.start()-45):m.end()+100]})
+ return output
+
+def physical_regions(source,page,tables,code_re,reader=None):
+ if source.get('id')not in SOURCES:return[]
+ if source.get('sha256')!=SOURCES[source['id']]:raise ValueError('RN role helper source hash mismatch')
+ reader=reader or NativeGlyphText(page);regions=[]
+ if source['id']=='rn-trilhas-aprofundamento':
+  labels={'investigacao cientifica','processos criativos','mediacao e intervencao sociocultural','empreendedorismo'}
+  # The four complete definition sheets precede the unit reference cards.
+  # Require an actual printed HABILIDADES heading, large outlined cells and prose.
+  full_text=reader.text();heading=next((line for line in full_text.splitlines()if re.match(r'^HABILIDADES\s*[-–]',line.strip())),None)
+  if heading:
+   for pi,path in enumerate(page.get_drawings()):
+    box=path['rect']
+    if path['type']!='s'or box.width<page.rect.width*.6 or not 40<box.height<page.rect.height*.45 or len(path['items'])!=1 or path['items'][0][0]not in('qu','re'):continue
+    text=reader.text(box)
+    if len(code_re.findall(text))<1 or len(code_re.sub('',text))<100:continue
+    regions.append({'role':'learning_definition','bbox':list(box),'text':text,'header':heading,'locator':f'vector-definition-cell:{pi}','path_index':pi})
+  for pi,path in enumerate(page.get_drawings()):
+   box=path['rect']
+   if path['type']!='s'or not 40<box.width<page.rect.width*.7 or not 18<box.height<160 or len(path['items'])!=1 or path['items'][0][0]not in('qu','re'):continue
+   text=reader.text(box)
+   if not code_re.search(text):continue
+   residue=norm(code_re.sub('',text)).strip(' ();:,.[]/–—-')
+   if residue not in labels:continue
+   regions.append({'role':'explicit_reference_code_card','bbox':list(box),'text':text,'header':residue,'locator':f'vector-reference-card:{pi}','path_index':pi})
+ else:
+  for ti,table in enumerate(tables):
+   headers=[]
+   for ri,row in enumerate(table.rows[:4]):
+    for ci,box in enumerate(row.cells):
+     if not box:continue
+     text=reader.text(box);role=role_of(text)
+     if role:headers.append({'role':role,'bbox':list(box),'text':text,'row':ri,'column':ci})
+   for ri,row in enumerate(table.rows):
+    for ci,box in enumerate(row.cells):
+     if not box:continue
+     x=(box[0]+box[2])/2
+     applicable=[h for h in headers if h['bbox'][0]-.5<=x<h['bbox'][2]+.5 and box[1]>=h['bbox'][3]-.5]
+     if not applicable:continue
+     h=min(applicable,key=lambda h:h['bbox'][2]-h['bbox'][0]);text=reader.text(box)
