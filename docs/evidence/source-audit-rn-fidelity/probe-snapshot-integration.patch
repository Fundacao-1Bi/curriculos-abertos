+  roles=[r['role']if r else'unknown'for a,r in matches]
+  if roles and (all(role in REFERENCE_ROLES for role in roles)or(source['id']=='rn-trilhas-aprofundamento'and all(role=='learning_definition'for role in roles))):
+   removed.append({'code':code,'locator':item['evidence'][0].get('locator'),'roles':roles,'old_text':item['text']})
+  else:kept.append(item)
+ definitions=[]
+ if source['id']=='rn-trilhas-aprofundamento':
+  for region in regions:
+   if region['role']!='learning_definition':continue
+   matches=list(code_re.finditer(region['text']))
+   for ci,match in enumerate(matches):
+    end=matches[ci+1].start()if ci+1<len(matches)else len(region['text']);tail=region['text'][match.end():end]
+    tail=re.sub(r'^[\s():;\-–—]+','',tail).strip()
+    if ci+1<len(matches)and tail.endswith('(')and tail.count('(')>tail.count(')'):tail=tail[:-1].rstrip()
+    text=clean_text(tail)
+    if not text:raise ValueError('Definition cell has code without wording; requires review')
+    item=make_item(source,match.group(),text,page_number,'rn-explicit-definition-cell-v1',region['locator']+f'/definition:{ci}',context=region['header'],quality='literal_definition_cell_checked')
+    item['evidence'][0].update(bbox=region['bbox'],excerpt=text)
+    item['source_context']={'documentary_role':'learning_definition','original_cell_text':region['text'],'cell_bbox':region['bbox'],'header':region['header'],'definition_order_in_cell':ci}
+    item['extraction_original_text']=region['text'];item['document_specific_adapter']='rn-document-roles-v1';definitions.append(item)
+ references=[]
+ for a,r in classified:
+  if not r or r['role']not in REFERENCE_ROLES:continue
