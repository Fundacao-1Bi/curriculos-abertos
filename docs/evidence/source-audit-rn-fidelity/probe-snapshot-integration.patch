+     regions.append({'role':h['role'],'bbox':list(box),'text':text,'header':h['text'],'header_bbox':h['bbox'],'locator':f'table:{ti}/row:{ri}/cell:{ci}','table':ti,'row':ri,'column':ci})
+ return regions
