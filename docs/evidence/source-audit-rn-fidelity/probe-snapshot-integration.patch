+ 'rn-trilhas-aprofundamento':'fac7333112fcfaac3d99d74f72f206bea8e9a4b256e770a9ea0f2eace99b027a',
+ 'rn-dcec-computacao':'886cdd02d96a63c50be00e93faf0fe5a9f7f305a959bd9920bcbdd429be134bd',
