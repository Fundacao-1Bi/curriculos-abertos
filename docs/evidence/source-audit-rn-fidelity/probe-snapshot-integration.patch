+REFERENCE_ROLES={'explanation_reference_context','example_reference_context','pedagogical_reference_context','knowledge_object_context','explicit_reference_code_card'}
+def norm(s):return re.sub(r'\s+',' ',''.join(c for c in unicodedata.normalize('NFKD',s or'').casefold()if not unicodedata.combining(c))).strip()
