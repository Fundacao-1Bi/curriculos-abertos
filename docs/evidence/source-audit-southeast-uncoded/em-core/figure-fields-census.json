      "kind": "eixo_estruturante",
      "text": "1 INVESTIGAÇÃO CIENTÍFICA • Supõe o aprofundamento de conceitos fundantes das ciências para a interpretação de ideias, fenômenos e processos para serem utilizados em procedimentos de investigação voltados ao enfrentamento de situações cotidianas e demandas locais e coletivas, e a proposição de intervenções que considerem o desenvolvimento local e a melhoria da qualidade de vida da comunidade.",
      "pixel_bbox_in_primary_crop": [
        0,
        0,
        905,
        124
      ],
      "title": "INVESTIGAÇÃO CIENTÍFICA",
      "source_number": "1",
      "component": null,
      "area": null
    },
